# Replace with your local MySQL username and password.
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost/hostel_management?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1

# Used only by `flask --app app init-db` when creating the first admin user.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hostel.local
ADMIN_PASSWORD=ChangeThisAdminPassword123!
